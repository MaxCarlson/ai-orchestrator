# PostgreSQL Configuration
POSTGRES_USER=km_user
POSTGRES_PASSWORD=km_secure_pass_change_me
POSTGRES_DB=knowledge_manager
POSTGRES_PORT=5432

# Orchestrator Configuration
LOG_LEVEL=INFO
WORKER_THREADS=4
TASK_POLL_INTERVAL=5
ORCHESTRATOR_PORT=8000

# LLM Router Configuration (RTX 5090)
LLAMA_CPP_HOST=host.docker.internal
LLAMA_CPP_PORT=8080

# pgAdmin Configuration (optional - use with: docker compose --profile admin up)
PGADMIN_EMAIL=admin@km.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

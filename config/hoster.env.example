# Shared hoster configuration (WSL2)
# Copy to config/hoster.env and export for shells/services.

# Knowledge Manager (km / kmtui)
KM_DB_TYPE=postgresql
KM_POSTGRES_HOST=localhost
KM_POSTGRES_PORT=5432
KM_POSTGRES_DB=knowledge_manager
KM_POSTGRES_USER=km_user
KM_POSTGRES_PASSWORD=CHANGE_ME

# Orchestrator Web Viewer (koweb)
KO_WEB_POSTGRES_HOST=localhost
KO_WEB_POSTGRES_PORT=5432
KO_WEB_POSTGRES_DB=knowledge_manager
KO_WEB_POSTGRES_USER=km_user
KO_WEB_POSTGRES_PASSWORD=CHANGE_ME
KO_WEB_ORCH_URL=http://localhost:8000
KO_WEB_TASK_QUEUE_PATH=/home/mcarls/projects/ai-orchestrator/task_queue
KO_WEB_PORT=3001
KO_WEB_LMS_BRIDGE_URL=http://localhost:5080
